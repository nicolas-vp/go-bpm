# Образец .env для compose.yaml: cp .env.example .env

# Пароль базы. Он подставляется в строку подключения, поэтому только буквы и цифры (без @ : / ? # %)
POSTGRES_PASSWORD=change-me

# Версия образа ghcr.io/nicolas-vp/go-bpm: latest - последний main, 1.2.3 - выпуск v1.2.3, sha-<коммит> - коммит
GO_BPM_TAG=latest

# Где слушать консоль и API на хосте. 0.0.0.0:8080 - открыть наружу (авторизации нет, лучше через прокси)
GO_BPM_LISTEN=127.0.0.1:8080
