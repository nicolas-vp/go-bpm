<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_BoundaryError" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:error id="Error_limit" name="Лимит превышен" errorCode="LIMIT_EXCEEDED" />
  <bpmn:process id="BoundaryError" isExecutable="true">
    <bpmn:startEvent id="s"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="pay" name="Оплатить"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
    <bpmn:boundaryEvent id="onLimit" name="LIMIT_EXCEEDED" attachedToRef="pay"><bpmn:errorEventDefinition errorRef="Error_limit" /><bpmn:outgoing>f4</bpmn:outgoing></bpmn:boundaryEvent>
    <bpmn:task id="ship" name="Отгрузить"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="e1"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="notify" name="Сообщить о лимите"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="e2"><bpmn:incoming>f5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="pay"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f2" sourceRef="pay" targetRef="ship"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f3" sourceRef="ship" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="onLimit" targetRef="notify"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" sourceRef="notify" targetRef="e2"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BoundaryError">
    <bpmndi:BPMNPlane id="Plane_BoundaryError" bpmnElement="BoundaryError">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="42" y="42" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pay_di" bpmnElement="pay"><dc:Bounds x="130" y="20" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="onLimit_di" bpmnElement="onLimit"><dc:Bounds x="182" y="82" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="222" y="104" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ship_di" bpmnElement="ship"><dc:Bounds x="280" y="20" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="432" y="42" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_di" bpmnElement="notify"><dc:Bounds x="280" y="150" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="432" y="172" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="78" y="60" /><di:waypoint x="130" y="60" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="230" y="60" /><di:waypoint x="280" y="60" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="380" y="60" /><di:waypoint x="432" y="60" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="200" y="118" /><di:waypoint x="200" y="190" /><di:waypoint x="280" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="380" y="190" /><di:waypoint x="432" y="190" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
